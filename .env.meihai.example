# ============================================================
#  Codex2API 完整配置（PostgreSQL + Redis 模式）
#  配合 docker-compose.meihai.yml 使用
#  镜像: meihai0211/codex:latest
# ============================================================

# ---- HTTP 服务 ----
# 服务端口（容器内外保持一致）
CODEX_PORT=8080
# 监听地址（0.0.0.0 = 所有网卡；127.0.0.1 = 仅本机）
BIND_HOST=0.0.0.0

# ---- 管理后台 ----
# 管理密钥：留空时首次访问 /admin 会引导浏览器设置
# 强烈建议生产环境通过环境变量预设强随机值（>=16 位）
ADMIN_SECRET=

# /v1/* 匿名访问（默认 false，强烈建议保持）
# true 时未配置任何 API Key 也能直接调用——仅限内网测试
CODEX_ALLOW_ANONYMOUS=false

# ---- 上游代理（可选） ----
# 整体 HTTP 代理（出口走代理时启用）
# CODEX_PROXY_URL=http://host.docker.internal:7890

# Codex 上游传输：http / ws / auto
# CODEX_UPSTREAM_TRANSPORT=http
# Codex HTTP TLS 指纹：standard / utls_chrome
# CODEX_TRANSPORT_MODE=standard
# 会话黏性 TTL（支持 1h / 90m / 秒数）
# CODEX_SESSION_AFFINITY_TTL=1h

# ---- 存储路径 ----
# 生图工作台图库目录（compose 已挂载 /data 持久卷）
IMAGE_ASSET_DIR=/data/images
# 日志目录
LOG_DIR=logs
# 禁用文件日志（只读文件系统设 true）
LOG_DISABLED=false

# ---- PostgreSQL ----
DATABASE_DRIVER=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=codex2api
DATABASE_PASSWORD=change-me-strong-password
DATABASE_NAME=codex2api
# 可选 schema（Supabase 等多项目共享 DB 场景）
# DATABASE_SCHEMA=codex2api

# ---- Redis ----
CACHE_DRIVER=redis
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_INSECURE_SKIP_VERIFY=false

# ---- 时区 ----
TZ=Asia/Shanghai
