# ============================================================
#  Codex2API 轻量配置（SQLite + 内存缓存）
#  配合 docker-compose.meihai.sqlite.yml 使用
#  镜像: meihai0211/codex:latest
# ============================================================

# ---- HTTP 服务 ----
CODEX_PORT=8080
BIND_HOST=0.0.0.0

# ---- 管理后台 ----
ADMIN_SECRET=
CODEX_ALLOW_ANONYMOUS=false

# ---- 存储路径 ----
IMAGE_ASSET_DIR=/data/images
LOG_DIR=logs
LOG_DISABLED=false

# ---- 数据库（SQLite） ----
DATABASE_DRIVER=sqlite
DATABASE_PATH=/data/codex2api.db

# ---- 缓存（内存） ----
CACHE_DRIVER=memory

# ---- 时区 ----
TZ=Asia/Shanghai
